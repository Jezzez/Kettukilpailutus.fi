# Kopioi tämä tiedostoksi .env.local paikallista kehitystä varten.
# .env.local on gitignoressa eikä päädy repoon.

# Admin-paneelin tunnus. Paikallisessa devissä tätä ei tarvitse asettaa —
# oletus on silloin "kettu-admin".
ADMIN_TOKEN=

# Kytkee admin-paneelin päälle tuotannossa. ÄLÄ aseta tätä Verceliin:
# serverless-ympäristön levy on vain luku -tilassa, joten tallennus ei toimi.
# Tarpeen vain, jos sivusto ajetaan omalla Node-palvelimella.
ADMIN_ENABLED=
